#!/usr/bin/env bash
#
# files-nest pre-commit hook: lint the Go server and test the Swift core when
# staged changes touch them.
#
# Each gate is a no-op unless at least one staged file lives under its
# folder. When server/ files are staged, it lints the whole module (not just
# the staged hunks) with the strict config in server/.golangci.yml. When
# apple/ files are staged, it runs `swift test` for the host-free
# FilesNestCore package (xcodebuild/UI tests are not run here — they need an
# interactive Keychain approval `xcodebuild test` can't get from a hook, so
# run those yourself in Xcode). Either gate blocks the commit on failure.
#
# Install once per clone, from the repo root:
#   git config core.hooksPath .githooks

set -u

# Staged files that were Added, Copied, or Modified.
staged="$(git diff --cached --name-only --diff-filter=ACM)"

# --- server/ : golangci-lint --------------------------------------------
if printf '%s\n' "$staged" | grep -q '^server/'; then
  # Fail closed if the linter is missing — never silently skip the gate.
  if ! command -v golangci-lint >/dev/null 2>&1; then
    printf '%s\n' \
      'ERROR: golangci-lint was not found on your PATH.' \
      '' \
      'This pre-commit hook requires golangci-lint v2+ to lint the Go server.' \
      'Install it (e.g. "brew install golangci-lint" on macOS, or the official' \
      'installer script) and make sure it is on your PATH, then re-run your' \
      'commit. See server/README.md for setup details.' >&2
    exit 1
  fi

  printf '%s\n' 'pre-commit: staged changes under server/ — running golangci-lint (strict config)...'

  # Lint the whole module rather than only staged hunks: a partial `git add -p`
  # stage can leave the working tree in a state that only fails when the full
  # module is analysed, so we lint ./... to catch it before it lands.
  if ! (cd server && golangci-lint run ./...); then
    printf '%s\n' \
      '' \
      'ERROR: golangci-lint reported violations in server/.' \
      'Fix them, then re-stage and commit again:' \
      '  cd server && make lint-fix   # auto-fix what can be fixed' \
      '  cd server && make lint       # verify zero violations remain' >&2
    exit 1
  fi
fi

# --- apple/ : swift test -------------------------------------------------
if printf '%s\n' "$staged" | grep -q '^apple/'; then
  if ! command -v swift >/dev/null 2>&1; then
    printf '%s\n' \
      'ERROR: swift was not found on your PATH.' \
      '' \
      'This pre-commit hook requires the Swift toolchain (Xcode) to test' \
      'FilesNestCore. Install Xcode / Xcode Command Line Tools, then re-run' \
      'your commit.' >&2
    exit 1
  fi

  printf '%s\n' 'pre-commit: staged changes under apple/ — running swift test (FilesNestCore)...'

  if ! (cd apple/FilesNestCore && swift test); then
    printf '%s\n' \
      '' \
      'ERROR: swift test failed for FilesNestCore.' \
      'Fix the failing tests, then re-stage and commit again:' \
      '  cd apple/FilesNestCore && swift test' >&2
    exit 1
  fi
fi

exit 0
